{
  "app-id": "io.github.cschalle.NegativeVibes.Devel",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "negative-vibes",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--filesystem=xdg-pictures",
    "--talk-name=org.freedesktop.portal.Desktop",
    "--talk-name=org.freedesktop.NvPortalProto",
    "--env=NV_SCANNER_BACKEND=portal",
    "--env=NV_PORTAL_BUS_NAME=org.freedesktop.NvPortalProto"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin"
  },
  "modules": [
    {
      "name": "sane-backends",
      "subdir": "backends",
      "buildsystem": "autotools",
      "config-opts": [
        "--disable-locking",
        "--with-usb"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/cschalle/OpticFilm8200i-sane.git",
          "commit": "e73221456902c6a12422ec24d49f191103642e1b"
        },
        {
          "type": "shell",
          "commands": [
            "echo 1.4.0 > backends/.tarball-version"
          ]
        }
      ],
      "make-args": [
        "SUBDIRS=include lib sanei backend tools"
      ],
      "make-install-args": [
        "SUBDIRS=include lib sanei backend tools"
      ]
    },
    {
      "name": "negative-vibes",
      "buildsystem": "meson",
      "build-options": {
        "build-args": [
          "--share=network"
        ],
        "env": {
          "CARGO_HOME": "/run/build/negative-vibes/cargo-home"
        }
      },
      "config-opts": [
        "-Dprofile=development",
        "-Dportal=true"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [
            "_build",
            "target",
            ".git",
            ".flatpak-builder",
            "build-flatpak",
            "repo",
            "screenshots",
            "scan-1200dpi-positive.png"
          ]
        }
      ]
    },
    {
      "name": "portal-test-scripts",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm644 portal_client.py -t /app/share/portal-test",
        "install -Dm755 scenarios.py hw_cancel.py -t /app/share/portal-test"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../../flatpak-scanner-portal/tests",
          "skip": [
            "__pycache__",
            "target"
          ]
        }
      ]
    }
  ]
}
