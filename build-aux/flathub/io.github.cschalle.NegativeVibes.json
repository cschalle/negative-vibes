{
  "app-id": "io.github.cschalle.NegativeVibes",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "negative-vibes",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=all",
    "--filesystem=xdg-pictures",
    "--env=SANE_CONFIG_DIR=/app/etc/sane.d"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": { "CARGO_HOME": "/run/build/negative-vibes/cargo-home" }
  },
  "modules": [
    {
      "name": "sane-backends",
      "config-opts": ["--disable-locking", "--with-usb"],
      "sources": [
        { "type": "archive", "url": "https://gitlab.com/sane-project/backends/-/archive/1.4.0/backends-1.4.0.tar.gz", "sha256": "FILL-IN" }
      ]
    },
    {
      "name": "ftjam",
      "buildsystem": "autotools",
      "build-options": { "env": { "CC": "gcc -std=gnu89 -fcommon" } },
      "cleanup": ["*"],
      "sources": [
        { "type": "archive", "url": "https://downloads.sourceforge.net/project/freetype/ftjam/2.5.2/ftjam-2.5.2.tar.bz2", "sha256": "e89773500a92912de918e9febffabe4b6bce79d69af194435f4e032b8a6d66a3" }
      ]
    },
    {
      "name": "argyllcms",
      "buildsystem": "simple",
      "build-commands": [
        "export OSTYPE=linux-gnu MACHTYPE=x86_64 HOSTTYPE=x86_64 && jam -q -fJambase -j${FLATPAK_BUILDER_N_JOBS} '<scanin>scanin' '<profile>colprof'",
        "install -Dm755 scanin/scanin profile/colprof -t /app/bin",
        "install -Dm644 ref/*.cht -t /app/share/color/argyll/ref",
        "install -Dm644 License.txt -t /app/share/licenses/argyllcms"
      ],
      "sources": [
        { "type": "archive", "url": "https://www.argyllcms.com/Argyll_V3.5.0_src.zip", "sha256": "f8576ce5589fd15620abb73ff049ea31f55ddbd1bba6d1ffa87452658e7bc85f", "strip-components": 1 }
      ]
    },
    {
      "name": "negative-vibes",
      "buildsystem": "meson",
      "config-opts": ["-Dprofile=default"],
      "sources": [
        { "type": "git", "url": "https://github.com/cschalle/negative-vibes.git", "tag": "v0.1.0" },
        "cargo-sources.json"
      ]
    }
  ]
}
